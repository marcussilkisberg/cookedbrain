{
  "name": "cookedbrain",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/c/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "cookedbrain", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": { "SITE": "https://cookedbrain.com" },
  "observability": { "enabled": true }
}
